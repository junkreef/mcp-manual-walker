# Everything the image does not need. The two that matter are `data/`, which
# holds the corpus and can be tens of gigabytes, and the virtualenvs, which are
# built for this host and would poison the one inside the image.
.git
.gitignore
.github

.venv
.venv-*
__pycache__
*.py[cod]
.pytest_cache
.mypy_cache
.ruff_cache
htmlcov
.coverage*

# The corpus, the databases and the caches: mounted at runtime, never baked in.
data/
cache/
.cache/
qdrant_storage/
poc/

# Local configuration, which belongs in the environment rather than the image.
.env
.env.*

tests/
docs/
*.md
!README.md

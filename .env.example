# -----------------
# Network Settings
# -----------------
# The IP address the server will listen on. Use '0.0.0.0' for network access (e.g., in Docker).
HOST=127.0.0.1
# The port the server will listen on.
PORT=8000

# -------------------
# Directory Settings
# -------------------
# The root directory where the PDF manuals are stored.
PDF_ROOT_DIR=./data/pdfs
# The file path for the SQLite database.
DB_FILE_PATH=./data/mcp_manual_walker.db
CHROMADB_PATH=./data/db/chroma_db
MARKDOWN_OUTPUT_DIR=./data/markdown
# Per-file build progress log, written by `db_manager build` and read by
# `db_manager watch`. Truncated at the start of every build; purely
# observational, so deleting it is always safe.
# BUILD_PROGRESS_FILE=./data/build_progress.jsonl

# -----------------
# Logging Settings
# -----------------
# The logging level for the application.
# Possible values: CRITICAL, ERROR, WARNING, INFO, DEBUG
LOG_LEVEL=INFO

# -----------------
# Docling Settings
# -----------------
# Number of threads for Docling processing. Defaults to CPU count if not set.
# DOCLING_NUM_THREADS=12

# Batch sizes for Docling processing pipeline (OCR, Layout, Table)
DOCLING_OCR_BATCH_SIZE=16
DOCLING_LAYOUT_BATCH_SIZE=16
DOCLING_TABLE_BATCH_SIZE=16

# Pages allowed to queue up in front of each pipeline stage. Docling's own
# default is 100, and since a queued page holds its rendered image until the
# assemble stage releases it, that is what sets peak memory -- not the length of
# the document. On a 600-page manual: 100 -> 8.2 GB peak, 32 -> 5.7 GB,
# 16 -> 5.0 GB, 8 -> 4.6 GB, with identical output and no measurable time cost.
# Lower it if a worker is close to the RAM ceiling; raise it only if a profile
# shows a stage starving.
# DOCLING_QUEUE_MAX_SIZE=16

# Pages per conversion unit. A document longer than this is converted as
# several page ranges, spread across the worker pool and merged in the parent,
# so a worker's peak memory follows this number rather than the length of the
# longest document in the corpus -- and one 2900-page manual no longer occupies
# a single worker while the rest of the GPU idles. Measured on a 1246-page
# manual with 250-page parts across 3 workers: 403 s / 5.93 GB converted whole
# against 286 s / 3.94 GB worst worker, byte-identical output. 0 disables it.
# DOCLING_SPLIT_PAGES=250

# How many things may use the GPU at once. The Docling workers and this
# builder's own embedding model share one device and neither yields to the
# other: on a 23 GB L4, three converting workers (17 GB) plus an embedding
# batch (5 GB) exhausted it three different ways in one afternoon -- the
# embedder unable to allocate 192 MB, RapidOCR's arena unable to allocate
# 142 MB (which drops that page's OCR silently rather than failing the
# document), and a document lost outright. A slot is held for one whole
# conversion or one whole embedding call, so embedding a finished document
# costs a converting worker until it is done. 0 removes the limit.
# DOCLING_GPU_SLOTS=3

# Render scale for the figure images stored in the SQLite figures table.
# 1.0 = 72 dpi, 2.0 = 144 dpi. Higher means sharper PNGs and a bigger DB.
# DOCLING_IMAGES_SCALE=2.0

# -----------------
# Splitter Settings
# -----------------
CHUNK_SIZE=2000
CHUNK_OVERLAP=200
CHUNK_OVERLAP_SEARCH_MARGIN=100

# -----------------------
# Worker Pipeline Settings
# -----------------------
# Number of processes for the fast metadata pass (file hashing + bookmark
# extraction via pypdf). 1 or less runs it inline in the main process.
# Defaults to max(1, cpu_count // 2) if not set.
# METADATA_WORKERS=4

# Number of Docling converter processes. Each worker loads its own copy of
# the layout/table/OCR models into VRAM and converts one PDF at a time, so
# N workers means N PDFs converting concurrently. This is the main knob for
# GPU utilization.
# DOCLING_WORKERS=1

# Total CPU-thread budget for Docling. Split evenly across DOCLING_WORKERS
# (DOCLING_NUM_THREADS // DOCLING_WORKERS per worker, minimum 1) so workers
# don't oversubscribe the available cores. Defaults to CPU count if not set.
# DOCLING_NUM_THREADS=12

# Accelerator device for Docling's layout/table/OCR models.
# Options: auto, cpu, cuda, cuda:0, mps
# DOCLING_DEVICE=auto

# RapidOCR inference backend: onnxruntime (default; japan/chinese/en models
# ship inside the rapidocr wheel, works offline, GPU via onnxruntime-gpu) or
# torch (always downloads .pth checkpoints from modelscope.cn on first use).
# DOCLING_OCR_BACKEND=onnxruntime

# RapidOCR language token for the recognition model. japan/chinese/en need no
# download; other languages (e.g. korean) are fetched from modelscope.cn.
# DOCLING_OCR_LANG=japan

# Device for the SentenceTransformers embedding model used by the builder.
# auto picks cuda when available, otherwise cpu. Can be forced to cpu/cuda/cuda:0.
# EMBEDDING_DEVICE=auto

# Torch dtype for the embedding weights. "auto" reads it from the checkpoint
# (bfloat16 for Qwen3-Embedding, 1.11 GiB); "float32" / "bfloat16" / "float16"
# force one instead. Leave it on auto for a GPU builder. Set float32 on a
# CPU-only search server: bfloat16 has no fast CPU kernels, and one query
# measured 0.86s under bfloat16 against 0.43s under float32 on an L4 host's
# CPU -- twice the RAM (2.22 GiB) for half the latency.
# EMBEDDING_DTYPE=auto

# Sizing DOCLING_WORKERS: both host RAM and VRAM bind, and the peak is set by
# the single document a worker is holding -- its length and its table density
# -- not by the size of the corpus. A worker's peak is roughly
#
#     4.0 GB  models, CUDA context, allocator floor, pages in flight
#   + 4.5 MB  per page of the longest document that worker may hold
#
# Measured on an L4 (31 GB RAM / 23 GB VRAM) at DOCLING_QUEUE_MAX_SIZE=16:
# a 2252-page manual peaked at 8.3 GB (1.9 MB/page), while a 2900-page
# table-dense one reached 16.7 GB and was still climbing (>=4.9 MB/page).
# Per-page retention varies by more than 2.5x with content, so budget with the
# pessimistic figure.
#
# VRAM is the second ceiling, and the builder's own embedding model shares the
# GPU with the workers: three workers were measured holding 19.4 GB of 22 GB,
# after which the parent could not allocate 542 MB to embed a finished
# document and the ingest failed with torch.OutOfMemoryError.
#
# DOCLING_SPLIT_PAGES is what keeps that variability out of the worker count:
# a longer document is converted as several page ranges in parallel and merged,
# so a worker's peak is 4 GB + 4.5 MB x DOCLING_SPLIT_PAGES whatever the
# document. Keep DOCLING_NUM_THREADS at or below your physical CPU core count
# so Docling workers don't oversubscribe the machine.

# -----------------------
# Embedding Settings
# -----------------------
# Sentence Transformers model id used to embed both search queries (server)
# and document chunks (builder). Must be identical on both sides.
# EMBEDDING_MODEL=Qwen/Qwen3-Embedding-0.6B

# Instruction text prepended to search queries before embedding. Left unset,
# this defaults to the prompt the model ships under the name "query" (for
# Qwen3-Embedding: the "Instruct: ... \nQuery:" instruction below). Set it
# explicitly only when switching to a model without stored prompts — e5-style
# models use "query: " / "passage: " prefixes instead. Pydantic-settings does
# not unescape "\n" in .env values, so leave this commented out rather than
# trying to edit it here.
# EMBEDDING_QUERY_PREFIX=Instruct: Given a web search query, retrieve relevant passages that answer the query\nQuery:

# Text prepended to every chunk at build time. Left unset, this defaults to
# the model's stored "document" prompt (for Qwen3-Embedding: nothing).
# EMBEDDING_DOCUMENT_PREFIX=

# Maximum tokens per text passed to the embedding model. Raise for very
# long chunks at the cost of VRAM/RAM.
# EMBEDDING_MAX_SEQ_LENGTH=4096

# Encode batch size used by the builder.
# EMBEDDING_BATCH_SIZE=32

# Upper bound on the padded tokens in one encode call, i.e. len(batch) x the
# longest text in it. A batch is padded to its longest member, so budgeting
# rows alone prices every batch at its worst one: on 562 real chunks, a single
# 3836-token figure caption among texts averaging 298 tokens took the peak
# from 4.4 GB to 18.6 GB of VRAM and the run from 11.9 s to 27.1 s. Measured
# at roughly 0.15 MB of VRAM per padded token on an L4 with
# Qwen3-Embedding-0.6B. 0 falls back to plain row batching.
# EMBEDDING_TOKEN_BUDGET=24576

# --------------------------------
# Figure Description Settings
# --------------------------------
# Ask a local OpenAI-compatible vision model to describe every detected
# figure. Empty (the default) disables the feature entirely.
# Ollama: http://localhost:11434/v1/chat/completions
# llama.cpp server: http://localhost:8080/v1/chat/completions
# PICTURE_DESCRIPTION_URL=http://localhost:11434/v1/chat/completions

# Sent as "model" in the request payload when set. Ollama requires it;
# llama.cpp's server ignores it (the model is fixed at server startup).
# PICTURE_DESCRIPTION_MODEL=gemma3:4b

# Sent as the "Authorization: Bearer ..." header when set.
# PICTURE_DESCRIPTION_API_KEY=

# Prompt sent alongside each figure crop. Defaults to a Japanese prompt
# tailored for technical manuals (see config.py); Pydantic-settings does not
# unescape newlines in .env values, so leave multi-line prompts unset here.
# PICTURE_DESCRIPTION_PROMPT=

# Upper bound on the generated description length.
# PICTURE_DESCRIPTION_MAX_TOKENS=300

# HTTP timeout per request to the vision API, in seconds.
# PICTURE_DESCRIPTION_TIMEOUT=120.0

# Parallel requests in flight per Docling worker. With DOCLING_WORKERS > 1,
# every worker sends its own requests, multiplying the load on the server.
# PICTURE_DESCRIPTION_CONCURRENCY=1

# Pictures smaller than this fraction of the page area are skipped.
# PICTURE_DESCRIPTION_AREA_THRESHOLD=0.02

# Changing EMBEDDING_MODEL changes the vector space: the server refuses to
# query a database built with a different embedding model. After switching
# models, rebuild with `uv run db_manager build --pdf_dir ./data/pdfs --reset`.

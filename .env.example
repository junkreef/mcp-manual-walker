# -----------------
# Network Settings
# -----------------
# The IP address the server will listen on. Use '0.0.0.0' for network access (e.g., in Docker).
HOST=127.0.0.1
# The port the server will listen on.
PORT=8000

# -------------------
# Directory Settings
# -------------------
# The root directory where the PDF manuals are stored.
PDF_ROOT_DIR=./data/pdfs
# The file path for the SQLite database.
DB_FILE_PATH=./data/mcp_manual_walker.db
CHROMADB_PATH=./data/db/chroma_db
MARKDOWN_OUTPUT_DIR=./data/markdown

# -----------------
# Logging Settings
# -----------------
# The logging level for the application.
# Possible values: CRITICAL, ERROR, WARNING, INFO, DEBUG
LOG_LEVEL=INFO

# -----------------
# Docling Settings
# -----------------
# Number of threads for Docling processing. Defaults to CPU count if not set.
# DOCLING_NUM_THREADS=12

# Batch sizes for Docling processing pipeline (OCR, Layout, Table)
DOCLING_OCR_BATCH_SIZE=16
DOCLING_LAYOUT_BATCH_SIZE=16
DOCLING_TABLE_BATCH_SIZE=16

# -----------------
# Splitter Settings
# -----------------
CHUNK_SIZE=2000
CHUNK_OVERLAP=200
CHUNK_OVERLAP_SEARCH_MARGIN=100

# -----------------------
# Worker Pipeline Settings
# -----------------------
# Number of processes for the fast metadata pass (file hashing + bookmark
# extraction via pypdf). 1 or less runs it inline in the main process.
# Defaults to max(1, cpu_count // 2) if not set.
# METADATA_WORKERS=4

# Number of Docling converter processes. Each worker loads its own copy of
# the layout/table/OCR models into VRAM and converts one PDF at a time, so
# N workers means N PDFs converting concurrently. This is the main knob for
# GPU utilization.
# DOCLING_WORKERS=1

# Total CPU-thread budget for Docling. Split evenly across DOCLING_WORKERS
# (DOCLING_NUM_THREADS // DOCLING_WORKERS per worker, minimum 1) so workers
# don't oversubscribe the available cores. Defaults to CPU count if not set.
# DOCLING_NUM_THREADS=12

# Accelerator device for Docling's layout/table/OCR models.
# Options: auto, cpu, cuda, cuda:0, mps
# DOCLING_DEVICE=auto

# RapidOCR inference backend: onnxruntime (default; japan/chinese/en models
# ship inside the rapidocr wheel, works offline, GPU via onnxruntime-gpu) or
# torch (always downloads .pth checkpoints from modelscope.cn on first use).
# DOCLING_OCR_BACKEND=onnxruntime

# RapidOCR language token for the recognition model. japan/chinese/en need no
# download; other languages (e.g. korean) are fetched from modelscope.cn.
# DOCLING_OCR_LANG=japan

# Device for the SentenceTransformers embedding model used by the builder.
# auto picks cuda when available, otherwise cpu. Can be forced to cpu/cuda/cuda:0.
# EMBEDDING_DEVICE=auto

# GPU tuning: start with DOCLING_WORKERS=2 and watch `nvidia-smi` for VRAM
# and utilization; raise to 3 if there's headroom, lower it if VRAM runs out
# or a worker dies. Keep DOCLING_NUM_THREADS at or below your physical CPU
# core count so Docling workers don't oversubscribe the machine.

# -----------------------
# Embedding Settings
# -----------------------
# Sentence Transformers model id used to embed both search queries (server)
# and document chunks (builder). Must be identical on both sides.
# EMBEDDING_MODEL=Qwen/Qwen3-Embedding-0.6B

# Instruction text prepended to search queries before embedding. Left unset,
# this defaults to the prompt the model ships under the name "query" (for
# Qwen3-Embedding: the "Instruct: ... \nQuery:" instruction below). Set it
# explicitly only when switching to a model without stored prompts — e5-style
# models use "query: " / "passage: " prefixes instead. Pydantic-settings does
# not unescape "\n" in .env values, so leave this commented out rather than
# trying to edit it here.
# EMBEDDING_QUERY_PREFIX=Instruct: Given a web search query, retrieve relevant passages that answer the query\nQuery:

# Text prepended to every chunk at build time. Left unset, this defaults to
# the model's stored "document" prompt (for Qwen3-Embedding: nothing).
# EMBEDDING_DOCUMENT_PREFIX=

# Maximum tokens per text passed to the embedding model. Raise for very
# long chunks at the cost of VRAM/RAM.
# EMBEDDING_MAX_SEQ_LENGTH=4096

# Encode batch size used by the builder.
# EMBEDDING_BATCH_SIZE=32

# Changing EMBEDDING_MODEL changes the vector space: the server refuses to
# query a database built with a different embedding model. After switching
# models, rebuild with `uv run db_manager build --pdf_dir ./data/pdfs --reset`.
